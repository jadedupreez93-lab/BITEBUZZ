<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Delicious Pasta Recipe</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.3.2/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 font-sans">

  <!-- Recipe Header -->
  <header class="bg-white shadow p-4">
    <h1 class="text-3xl font-bold mb-2">Delicious Pasta</h1>
    <p class="text-gray-700">A quick and easy pasta recipe for everyone.</p>
  </header>

  <!-- Ad Placeholder -->
  <div id="ad-recipe" class="w-full h-20 bg-gray-200 text-center my-4">Ad Space</div>

  <!-- Ingredients & Steps -->
  <main class="p-4 max-w-2xl mx-auto bg-white shadow rounded">
    <h2 class="text-2xl font-bold mb-2">Ingredients</h2>
    <ul class="list-disc list-inside mb-4">
      <li>200g Pasta</li>
      <li>2 Tomatoes</li>
      <li>1 Onion</li>
      <li>2 cloves Garlic</li>
    </ul>

    <h2 class="text-2xl font-bold mb-2">Steps</h2>
    <ol class="list-decimal list-inside">
      <li>Boil pasta in salted water.</li>
      <li>Sauté onions and garlic.</li>
      <li>Add tomatoes and cook 5 mins.</li>
      <li>Mix pasta and sauce. Serve hot.</li>
    </ol>
  </main>

</body>
</html>
